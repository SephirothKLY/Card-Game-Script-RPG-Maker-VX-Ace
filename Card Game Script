  # Card effects
  #-----------------------------------------------------------------------------
  def invoke_card_impact(effect_name)
    array = PC27::CG::CARD_EFFECT[effect_name]
    if array[0] == :draw
      card_effect_draw_cards(array[1], array[2], array[3])
    else
