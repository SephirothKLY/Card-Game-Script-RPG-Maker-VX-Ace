    return amount_banish_cards
  end
  
  #-----------------------------------------------------------------------------
  # Mill n random cards from your deck to your banish (new)
  #-----------------------------------------------------------------------------
  def mill_banish_cards(n)
    amount_mill_banish_cards = 0
    if n == 0
      amount_mill_banish_cards += @deck.size
      @banish += @deck
      @deck = []
    else
