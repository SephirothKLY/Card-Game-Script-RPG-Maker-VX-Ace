  #-----------------------------------------------------------------------------
  # Tries to put a specific card from your field to your stack (new)
  #-----------------------------------------------------------------------------
  def card_to_field?(id)
    init_card_zones
    index_hand = @hand.index { |c| c.id == id }
    return false unless index_hand
    card = @hand[index_hand]
    index_field = @monster_zones.index(nil)
    return false unless index_field
    @monster_zones[index_field] = card
    @hand.delete_at(index_hand)
    true
  end
  
  #-----------------------------------------------------------------------------
  # Tries to put a specific spell/trap from hand to field (new)
  #-----------------------------------------------------------------------------
  def spell_to_field?(id)
    init_card_zones
    index_hand = @hand.index { |c| c.id == id }
    return false unless index_hand
    card = @hand[index_hand]
    if card.subtype == 27
      if @field_zone != nil
        @grave.push(@field_zone)
        @field.delete(@field_zone)
      end
      @field_zone = card
      @field.push(card)
      @hand.delete_at(index_hand)
      return true
    else
      index_field = @st_zones.index(nil)
      return false unless index_field
      @st_zones[index_field] = card
      @field.push(card)
      @hand.delete_at(index_hand)
      return true
    end
  end
 
  #-----------------------------------------------------------------------------
