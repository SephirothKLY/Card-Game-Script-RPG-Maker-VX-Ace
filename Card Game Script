      elsif /<card[ -_]level: +(?<lvnr>\d+)>/i =~ line
        @level = lvnr.to_i
      elsif /<card[ -_]normeff: +(?<nenr>\d+)>/i =~ line
        @normeff = nenr.to_i
      elsif /<card[ -_]frame: +(?<frnr>\d+)>/i =~ line
        @frame = frnr.to_i
      elsif /<card[ -_]archetype: +(?<arnr>\d+)>/i =~ line
        @archetype = arnr.to_i
      elsif /<card[ -_]atk: +(?<atnr>\d+)>/i =~ line
        @atk = atnr.to_i
      elsif /<card[ -_]def: +(?<dfnr>\d+)>/i =~ line
        @def = dfnr.to_i
      elsif /<card[ -_]special: +(?<spnr>\d+)>/i =~ line
        @special = spnr.to_i
      elsif /<card[ -_]cost: +(?<cst>.+)>/i =~ line
        @cost = cst
      elsif /<card[ -_]impact: +(?<imp>.+)>/i =~ line
        @impact = imp
      elsif /<card[ -_]impact2: +(?<imp2>.+)>/i =~ line
        @impact2 = imp2
      elsif /<(?:field)[ ](\d+)>/i =~ line
        @fieldeff = $1.to_i
      elsif /<(?:grave)[ ](\d+)>/i =~ line
        @graveeff = $1.to_i
      elsif /<(?:hand)[ ](\d+)>/i =~ line
        @handeff = $1.to_i
      elsif /<hand[-_ ]impact:\s*(.+?)>/i =~ line
        @hand_impact = $1.to_s.strip
      elsif /<grave[-_ ]impact:\s*(.+?)>/i =~ line
        @grave_impact = $1.to_s.strip
      elsif /<field[-_ ]impact:\s*(.+?)>/i =~ line
