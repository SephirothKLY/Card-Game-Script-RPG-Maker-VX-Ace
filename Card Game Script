  #-----------------------------------------------------------------------------
  # Replace Field Spell
  #-----------------------------------------------------------------------------
  def replace_field_spell(id)
    for i in (0...@field.length)
      if @field[i].subtype == id
        @grave.push(@field[i])
        @field.delete_at(i)
        return true
      end
    end
    return false
  end
  
  #-----------------------------------------------------------------------------
  # Shuffles Deck and draws cards at the begin of each battle (new)
  #-----------------------------------------------------------------------------
  def on_battle_start
    super()
    shuffle_deck(false)
    draw_cards(starting_cards, false, false)
    @turn_actions[:can_attack] = true
    @turn_actions[:can_guard]  = true
    @turn_actions[:actions]    = available_actions
  end
 
  #-----------------------------------------------------------------------------
  # Starting Cards (new)
  #-----------------------------------------------------------------------------
  def starting_cards
    x = PC27::CG::START_CARDS
    @equips.each { |equip|
      next unless equip
      next unless equip.object
      x += equip.object.extra_start_cards
    }
    return x
  end
  
  #-----------------------------------------------------------------------------
  # Draws a card at the end of each turn (new)
  #-----------------------------------------------------------------------------
  def on_turn_end
    super()
    if self.respond_to?(:used_turn_effects) && self.used_turn_effects
      self.used_turn_effects.clear 
      puts "[SISTEMA] Memoria de turnos limpiada para #{self.name} (on_turn_end)"
    end
    if $game_party.in_battle && !death_state? 
      draw_cards(turn_cards, false, false)
      @turn_actions[:can_attack] = true
      @turn_actions[:can_guard]  = true
      @turn_actions[:actions]    = available_actions
    end
  end
 
  #-----------------------------------------------------------------------------
  # Determines the amount of actions an actor can make (new)
  #-----------------------------------------------------------------------------
  def available_actions
    for id in @states
      state = $data_states[id]
      if state.limited_actions != 0
        x = state.limited_actions if x.nil? || x > state.limited_actions
      end
    end
    if PC27::CG::MAX_ACTIONS <= 0
      return (x ? x : -1)
    else
      return (x ? [x, PC27::CG::MAX_ACTIONS].min : PC27::CG::MAX_ACTIONS)
    end
  end
  
  #-----------------------------------------------------------------------------
  # Turn Cards(new)
  #-----------------------------------------------------------------------------
  def turn_cards
    x = 1
    if state?(82)
      x = 0
    end
    @equips.each { |equip|
      next unless equip
      next unless equip.object
      x += equip.object.extra_turn_cards
      if state?(82)
        x = 0
      end
    }
    return x
  end
  
  #-----------------------------------------------------------------------------
  # Restore deck at the end of battle (new)
  #-----------------------------------------------------------------------------
  def on_battle_end
    @deck += @hand + @grave + @banish + @field
    @deck.select! { |card| card.frame != 5 }
    @deck.select! { |card| card.type != 4 }
    @extra += @hand + @grave + @banish + @field
    @extra.select! { |card| card.type == 4 }
    @hand, @grave, @banish, @field = [],[],[],[]
    super()
    end
  
  #--------------------------------------------------------------------------
  # * Determine Usability of Attack
  #--------------------------------------------------------------------------
  def attack_usable?
    super && @turn_actions[:can_attack]
  end
  
  #--------------------------------------------------------------------------
  # * Determine Usability of Guard
  #--------------------------------------------------------------------------
  def guard_usable?
    super && @turn_actions[:can_guard]
  end
  
end
 
