class Window_FieldMap < Window_Selectable
  attr_accessor :actor
  attr_accessor :preview_window
  
  def initialize(x, y, actor)
    @actor = actor
    super(x, y, Graphics.width / 2, 300)
    @zones = []
    make_zone_list
    select(0)
    activate
    refresh
  end
  
  alias fieldmap_select select
  def select(index)
    fieldmap_select(index)
    update_preview
  end
    
  def refresh
    contents.clear
    draw_all_items
  end
  
  def update
    super
  end
 
  def update_preview
    return unless @preview_window
    return unless @actor
    zone, i = current_zone
    card = @actor.card_in_zone(zone, i)
    @preview_window.set_card(card)
  end
  
  def make_zone_list
    @zones = []
    5.times { |i| @zones << [:monster, i] }
    5.times { |i| @zones << [:spell, i] }
    @zones << [:fieldspell, 0]
  end
  
  def item_max
    @zones ? @zones.size : 0
  end
  
  def item_rect(index)
    rect = Rect.new
    zone, i = @zones[index]
    case zone
    when :monster
      rect.x = 14 + i * 48
      rect.y = 120
    when :spell
      rect.x = 14 + i * 48
      rect.y = 180
    when :fieldspell
      rect.x = (width / 2) - 24
      rect.y = 60
    end
    rect.width  = 24
    rect.height = 24
    rect
  end
  
  def draw_item(index)
    zone, i = @zones[index]
    rect = item_rect(index)
    card = @actor.card_in_zone(zone, i) if @actor
    puts "[FieldMap] index=#{index} zone=#{zone} i=#{i}"
    puts "[FieldMap] card=#{card.inspect}"
    if card
      draw_icon(card.icon_index, rect.x, rect.y)
    else
      case zone
      when :monster
        draw_icon(1019, rect.x, rect.y)
      when :spell
        draw_icon(1020, rect.x, rect.y)
      when :fieldspell
        draw_icon(1021, rect.x, rect.y)
      end
    end
  end
  
  def cursor_up(wrap = false)
    zone, i = @zones[index]
    case zone
    when :monster
      select(10)
    when :spell
      select(i)
    end
  end
 
  def cursor_down(wrap = false)
    zone, i = @zones[index]
    case zone
    when :monster
      select(5 + i)
    when :fieldspell
      select(0)
    end
  end
  
  def cursor_left(wrap = false)
    return if index == 10
    select([index - 1, row_start(index)].max)
  end
 
  def cursor_right(wrap = false)
    return if index == 10
    select([index + 1, row_end(index)].min)
  end
 
  def row_start(index)
    return 10 if index == 10
    index < 5 ? 0 : 5
  end
 
  def row_end(index)
    return 10 if index == 10
    index < 5 ? 4 : 9
  end
  
  def current_zone
    @zones[index]
  end
 
end
 
