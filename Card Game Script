class Window_SkillList < Window_Selectable
  attr_accessor :cursor_opacity
 
  def initialize(x, y, width, height)
    super(x, y, Graphics.width, 300)
    @data = []
    @last_selected_index = nil
    @highlight_counter = 0
    make_item_list
    refresh
  end
 
  def create_contents
    self.contents.dispose if self.contents
    self.contents = Bitmap.new(
      width - padding * 2,
      height - padding * 2
    )
  end
  
  def make_item_list
    @actor ||= $game_party.battle_members[0]
    return @data = [] if @actor.nil?
    case @actor.current_zone
    when :hand
      @actor.sort_cards(:hand)
      @data = @actor.hand || []
    when :field
      @data = @actor.field || []
    when :graveyard
      @data = @actor.grave || []
    when :banish
      @data = @actor.banish || []
    when :extra
      @data = @actor.extra || []
    when :deck
      @data = @actor.deck || []
    else
      @data = @actor.hand || []
    end
    if @data.empty?
      self.index = -1 if respond_to?(:index=)
    else
      self.index = 0 if respond_to?(:index=) && (self.index.nil? || self.index < 0 || self.index >= @data.size)
    end
  end
 
  def refresh
    contents.clear if contents
    return if @data.nil? || @data.empty?
    selected_index = self.index
    selected_index = nil if selected_index.nil? || selected_index < 0 || selected_index >= @data.size
    unless selected_index
      (0...@data.size).to_a.reverse.each do |index|
        draw_item(index)
      end
      return
    end
    left_count = selected_index
    right_count = @data.size - selected_index - 1
    max_steps = [left_count, right_count].max
    (0..max_steps).each do |step|
      left_index = step
      draw_item(left_index) if left_index < selected_index
      right_index = @data.size - step - 1
      draw_item(right_index) if right_index > selected_index
    end
    draw_item(selected_index)
    draw_highlight(selected_index) if selected_index
    @last_selected_index = selected_index
  end
 
  def draw_item(index)
    card = @data[index]
    return unless card
    rect = item_rect(index)
    draw_card_illustration(card, rect.x, rect.y)
  end
 
  def draw_card_illustration(card, x, y)
    bitmap = Cache.picture("Card" + card.id.to_s)
    return unless bitmap
    if y >= 0 && y + 264 <= contents.height
      rect = Rect.new(0, 0, 190, 264)
      contents.blt(x, y, bitmap, rect)
    else
      puts "WARNING: Card at y=#{y} would be clipped!"
    end
  end
  
  def draw_highlight(index)
    return if index < 0 || index >= @data.size
    rect = item_rect(index)
    overlay = Cache.picture("blank_rectangle")
    return unless overlay
    opacity = 30 + (Math.sin(@highlight_counter / 20.0) * 64).abs
    overlay_opacity = opacity
    contents.blt(rect.x, rect.y, overlay, Rect.new(0, 0, overlay.width, overlay.height), overlay_opacity)
  end
  
  def item_rect(index)
    return Rect.new(0, 0, 0, 0) unless @data && !@data.empty?
    total_cards = @data.size
    card_width = 190
    card_height = 264
    usable_width = width - standard_padding * 2
    if total_cards > 1
      overlap = [(card_width * total_cards - usable_width) / (total_cards - 1), card_width].min
      overlap = [overlap, 0].max
    else
      overlap = 0
    end
    x = index * (card_width - overlap)
    y = 12
    Rect.new(x, y, card_width, card_height)
  end
  
  def item_height
    276
  end
 
  def row_max
    1
  end
 
  def contents_height
    height - standard_padding * 2
  end
  
  def ensure_cursor_visible
  end
 
  def cursor_visible?
    active && open? && !@cursor_all && @index >= 0
  end
  
  def update_cursor
    if @cursor_all
      cursor_rect.set(rect.x, rect.y, contents.width, contents.height)
      self.cursor_opacity = 255
    elsif @index < 0
      cursor_rect.empty
      self.cursor_opacity = 0
    else
      rect = item_rect(@index)
      cursor_rect.set(rect.x, rect.y, rect.width, rect.height)
      self.cursor_opacity = cursor_visible? ? 255 : 0
    end
  end
 
  def update
    super
    if @last_index != self.index
      @last_index = self.index
      refresh
    end
    @highlight_counter += 1
    refresh if @highlight_counter % 1 == 0
  end
  
  def cursor_down(wrap = false); end
  def cursor_up(wrap = false); end
  def cursor_right(wrap = false)
    return if item_max <= 0
    self.index = (self.index + 1) % item_max
  end
  
  def cursor_left(wrap = false)
    return if item_max <= 0
    self.index = (self.index - 1) % item_max
  end
  
  alias pc27_process_ok_graveblock process_ok
  def process_ok
    actor = BattleManager.actor
    return pc27_process_ok_graveblock unless actor
    if actor.current_zone == :graveyard
      skill = item
      if skill.nil?
        Sound.play_buzzer
        return
      end
      unless card_has_grave_effect?(skill)
        Sound.play_buzzer
        return
      end
    end
    pc27_process_ok_graveblock
  end
  
  def card_has_grave_effect?(skill)
    skill.note =~ /<grave[-_ ]?effect/i || skill.note =~ /<grave/i
  end
  
  def monster_has_hand_effect?(skill)
    skill.note =~ /<hand[-_ ]?effect>/i || skill.note =~ /<hand/i
  end
  
end
