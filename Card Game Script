  def resolve_card_effect(skill)
    if skill.cost
      invoke_card_cost(skill.cost)
    elsif skill.impact
      invoke_card_impact(skill.impact)
    else
      skill_select(1)
    end
  end
  
  def handle_hand_skill(skill)
    case skill.type
    when 1
      options = []
      if skill.subtype == 27 || BattleManager.actor.st_zone_available?
        options << "Activate"
      end
      options << "Cancel"
      show_options(options, options.size) do |choice|
        selected = options[choice]
        case selected
        when "Activate"
          $game_message.choice_proc = nil
          $game_message.clear
          if @message_window
            choice_window = @message_window.instance_variable_get(:@choice_window)
            choice_window.openness = 0 if choice_window
          end
          if BattleManager.actor.spell_to_field?(skill.id)
            @field_map_window.refresh if @field_map_window
            @field_preview_window.set_card(nil) if @field_preview_window
            @skill_window.hide
            @skill_window.deactivate
            @card_zone_label.hide if @card_zone_label
            resolve_card_effect(skill)
          else
            Sound.play_buzzer 
            @skill_window.activate
          end
        when "Cancel"
          $game_message.choice_proc = nil
          $game_message.clear
          @skill_window.activate
        end
      end
    when 2
      show_options(["Set", "Cancel"], 2) do |choice|
        if choice == 0
          $game_message.choice_proc = nil
          $game_message.clear
            if @message_window
              choice_window = @message_window.instance_variable_get(:@choice_window)
              choice_window.openness = 0 if choice_window
            end
          BattleManager.actor.card_to_stack?(skill.id)
          skill_select(1)
        else
          $game_message.choice_proc = nil
          $game_message.clear
          @skill_window.activate
        end
      end
    when 3
      special_eff = nil
      is_special_only = false
      is_special = false
      if skill.note =~ /<special_only:\s*(.+?)>/i
        is_special_only = true
        special_eff = $1.to_s.strip
      elsif skill.note =~ /<special:\s*(.+?)>/i
        is_special = true
        special_eff = $1.to_s.strip
      end
      options = []
      if !is_special_only && @subject.tp >= skill.tp_cost
        if BattleManager.actor.free_monster_zone_available?
          options << "Normal Summon"
        end
      end
      if special_eff && BattleManager.actor.free_monster_zone_available?
        if BattleManager.actor.meets_activation_requirements?(skill, special_eff)
          options << "Special Summon"
        end
      end
      if skill.hand_impact
        options << "Activate" 
      end
      options << "Cancel"
      show_options(options, options.size) do |choice|
        selected = options[choice]
        case selected
        when "Normal Summon"
          $game_message.choice_proc = nil
          $game_message.clear
          if @message_window
            choice_window = @message_window.instance_variable_get(:@choice_window)
            choice_window.openness = 0 if choice_window
          end
          if BattleManager.actor.card_to_field?(skill.id)
            @field_map_window.refresh if @field_map_window
            @field_preview_window.set_card(nil) if @field_preview_window
            @skill_window.hide
            @card_zone_label.hide if @card_zone_label
            @current_card_action = :summon 
            skill_select(1)
          else 
            Sound.play_buzzer 
            @skill_window.activate
          end
        when "Special Summon"
          $game_message.choice_proc = nil
          $game_message.clear
          if @message_window
            choice_window = @message_window.instance_variable_get(:@choice_window)
            choice_window.openness = 0 if choice_window
          end
          @field_map_window.refresh if @field_map_window
          @skill_window.hide.deactivate
          @card_zone_label.hide if @card_zone_label
          @active_effect_card = skill
          invoke_card_impact(special_eff)
        when "Activate"
          $game_message.choice_proc = nil
          $game_message.clear
          if @message_window
            choice_window = @message_window.instance_variable_get(:@choice_window)
            choice_window.openness = 0 if choice_window
          end
          BattleManager.actor.card_to_stack?(skill.id) 
          @current_card_action = :hand_effect 
          resolve_card_effect(skill) 
          
        when "Cancel"
          $game_message.choice_proc = nil
          $game_message.clear
          @skill_window.activate
        end
      end
    end
  end
 
  def show_options(choices, cancel_type, &block)
    choices.each { |s| $game_message.choices.push(s) }
    $game_message.choice_cancel_type = cancel_type
    $game_message.choice_proc = Proc.new { |n| block.call(n) }
  end
    
  def skill_select(value)
    @skill_window.hide if @skill_window.visible
    @card_zone_label.hide if @card_zone_label.visible
    $game_message.clear
    $game_message.visible = false
    if @skill.cost
      invoke_card_cost(@skill.cost)
      @skill_window.hide
      @card_zone_label.hide
    else
      effect = @skill.handeff if value == 0
      effect = @skill.id
      @current_card_action = :hand_effect if value == 0
      @current_card_action = :summon if value == 1   
      BattleManager.actor.input.set_skill(effect)
      BattleManager.actor.last_skill.object = @skill
      if !@skill.need_selection?
        @skill_window.hide
        @card_zone_label.hide
        next_command
      elsif @skill.for_opponent?
        select_enemy_selection
      else
        select_actor_selection
      end
    end
  end
  
