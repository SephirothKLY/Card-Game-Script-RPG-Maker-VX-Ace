  ZONE_LABELS = {
    hand:       ["Hand", 800],
    field:      ["Field", 1015],
    grave:      ["Graveyard", 801],
    graveyard:  ["Graveyard", 801],
    banish:     ["Banish", 806],
    extra:      ["Extra", 815],
    deck:       ["Deck", 783]
  }
  
  alias pc27_turn_start_fix turn_start
  def turn_start
    pc27_turn_start_fix
    if BattleManager.actor
      BattleManager.actor.used_turn_effects.clear
    end
    @pending_triggers ||= []
  end
 
  def prior_command
    start_actor_command_selection
  end
  
  alias rescate_seguro_on_skill_cancel on_skill_cancel
  def on_skill_cancel
    rescate_seguro_on_skill_cancel
    if @actor_command_window
      @actor_command_window.show
      @actor_command_window.activate
    end
  end
  
  def update_field_preview
    return unless @field_map_window && @field_map_window.active
    zone, index = @field_map_window.current_zone
    card = BattleManager.actor.card_in_zone(zone, index)
    @field_preview_window.set_card(card)
  end
  
  def command_skill
    @skill_window.make_item_list
    @skill_window.refresh
    @skill_window.show
    @skill_window.activate
  end
  
  def on_field_map_ok
    zone, index = @field_map_window.current_zone
    actor = BattleManager.actor
    card  = @pending_card
    if actor.card_to_field?(card.id, zone, index)
      Sound.play_ok
      @field_map_window.refresh
      @field_preview_window.set_card(nil)
      @pending_card = nil
      skill_select(1)
    else
      Sound.play_buzzer
    end
  end
  
  def on_field_ok
    zone_type, zone_index = @field_map_window.current_zone
    card = BattleManager.actor.card_in_zone(zone_type, zone_index)
    if @targeting_mode
      if card
        filter = @targeting_filter
        ok = true
        ok = false if filter[0] != 0 && card.attribute != filter[0]
        ok = false if filter[1] != 0 && card.type      != filter[1]
        ok = false if filter[3] != 0 && card.subtype   != filter[3] # Dinosaurio
        if @active_effect_card && @active_effect_zone_index
          if zone_type == @active_effect_zone_type && zone_index == @active_effect_zone_index
            ok = false 
          end
        end
        if ok
          @targeting_mode = false
          @temp_effect_data[3] = [card]
          BattleManager.actor.field.delete(card) 
          if zone_type == :monster
            BattleManager.actor.monster_zones[zone_index] = nil
          end
          @field_map_window.hide
          @field_map_window.deactivate
          @field_preview_window.hide if @field_preview_window
          $game_message.clear
          restore_taken_cards(:proceed)
        else
          Sound.play_buzzer 
          @field_map_window.activate
        end
      else
        Sound.play_buzzer 
        @field_map_window.activate
      end
      return
    end
    if card && card.type == 3 && BattleManager.actor.can_activate_field_effect?(card)
      show_options(["Activate Effect", "Cancel"], 2) do |choice|
        if choice == 0
          $game_message.choice_proc = nil
          $game_message.clear
          if @message_window
            choice_window = @message_window.instance_variable_get(:@choice_window)
            choice_window.openness = 0 if choice_window
          end
          @field_map_window.hide
          @field_map_window.deactivate
          @field_preview_window.hide if @field_preview_window
          @current_card_action = :field_effect
          @active_effect_card = card
          @active_effect_zone_type = zone_type
          @active_effect_zone_index = zone_index
          BattleManager.actor.used_turn_effects << card.field_impact
          if card.note =~ /<shared_opt:\s*(.+?)>/i
            BattleManager.actor.used_turn_effects << $1.to_s.strip
          end
          invoke_card_impact(card.field_impact)
        else
          $game_message.choice_proc = nil
          $game_message.clear
          @field_map_window.activate
        end
      end
    else
      Sound.play_buzzer
      @field_map_window.activate
    end
  end
  
  #--------------------------------------------------------------------------
  # Muestra los efectos visuales de una Invocación Especial (Sincronizado)
  #--------------------------------------------------------------------------
  def show_special_summon_visuals(card)
    return unless card
    @card_zone_label.hide if @card_zone_label
    @status_window.hide if @status_window
    @status_back_window.hide if @status_back_window
    @skill_window.hide if @skill_window
    if @log_window
      @log_window.clear
      @log_window.add_text(BattleManager.actor.name + " summons " + card.name + "!")
    end
    BattleManager.actor.animation_id = 43 # Seal 1
    wait_for_animation
    20.times do
      update_basic
    end
    if @log_window
      @log_window.clear
    end
    restore_hud_visibility
  end
