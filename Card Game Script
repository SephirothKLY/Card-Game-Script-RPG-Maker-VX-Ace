  #-----------------------------------------------------------------------------
  # Evaluates card effects and puts the stack to the grave (alias)
  #-----------------------------------------------------------------------------
  alias pc27_cardgame_scenebattle_use_item use_item
  def use_item
    pc27_cardgame_scenebattle_use_item
    if @subject.is_a?(Game_Actor)
      effect_name = @subject.current_action.item.impact
      invoke_card_impact(effect_name) if effect_name
      card = @subject.current_action.item
      effect_name = nil
      if card.type == 3
        if @current_card_action == :hand_effect 
          effect_name = card.hand_impact
          invoke_card_impact(effect_name) if effect_name
        elsif @current_card_action == :summon 
          if card.summon_impact && BattleManager.actor.can_activate_summon_effect?(card)
            $game_message.clear
            if @message_window
              @message_window.openness = 0
              @message_window.visible = true
            end
            $game_message.background = 1 
            $game_message.position = 1   
            $game_message.add("Do you want to activate the effect of")
            $game_message.add('"' + card.name + '"?')
            @status_window.hide if @status_window
            @status_back_window.hide if @status_back_window
            show_options(["Yes", "No"], 2) do |choice|
              @status_window.show if @status_window
              @status_back_window.show if @status_back_window
              $game_message.choice_proc = nil
              $game_message.clear
              if @message_window
                choice_window = @message_window.instance_variable_get(:@choice_window)
                choice_window.openness = 0 if choice_window
              end
              if choice == 0 
                BattleManager.actor.used_turn_effects ||= []
                BattleManager.actor.used_turn_effects << card.summon_impact
                if card.note =~ /<shared_opt:\s*(.+?)>/i
                  BattleManager.actor.used_turn_effects << $1.to_s.strip
                end
                invoke_card_impact(card.summon_impact)
              else 
                @return_to_hand_flag = true
                if @actor_command_window
                  @actor_command_window.hide.deactivate
                end
                command_look_hand
              end
            end
            return
          else
            @return_to_hand_flag = true
          end
        end
      elsif card && [24, 25, 29, 31].include?(card.subtype)
        index = @subject.st_zones.index { |c| c && c.id == card.id }
        if index
          actual_card = @subject.st_zones[index]
          @subject.st_zones[index] = nil 
          @subject.field.delete(actual_card) 
          @subject.grave.push(actual_card) 
          @field_map_window.refresh if @field_map_window 
        end
      end
      if @subject.stack.size > 0
        @subject.grave += @subject.stack
        @subject.stack = [] 
      end
      restore_taken_cards(:proceed)
      if !effect_name && @subject.current_zone == :hand
        @return_to_hand_flag = true
      end
      if @subject.current_zone == :hand
        opened_window = false
        if effect_name
          array = PC27::CG::CARD_EFFECT[effect_name]
          opened_window = true if array && array[0] != :draw 
        end
        if !opened_window
          @return_to_hand_flag = true
        end
      end
    end
  end
  
