    self.note.split(/[\r\n]+/).each { |line|
      if /<card[ -_]id: +(?<inr>\d+)>/i =~ line
        @card_id = inr.to_i
      elsif /<card[ -_]type: +(?<tnr>\d+)>/i =~ line
        @type = tnr.to_i
      elsif /<card[ -_]rarity: +(?<rnr>\d+)>/i =~ line
