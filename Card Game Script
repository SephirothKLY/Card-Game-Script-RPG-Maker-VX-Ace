    if n == 0
      amount_send_field += @field.size
      @grave += @field
      @field = []
    else
      n.times do
        break if @field.size == 0
        @grave.push(@field.slice!(rand(@field.size-1)))
        amount_send_field += 1
      end
    end
  end
  
  #-----------------------------------------------------------------------------
  # Puts n random card(s) TYPE from your field to your grave (new)
  #-----------------------------------------------------------------------------
  def send_card_from_field(n)
