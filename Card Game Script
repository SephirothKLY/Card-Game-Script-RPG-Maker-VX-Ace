  attr_accessor :field_zone
  attr_accessor :stack
  attr_accessor :turn_actions
  attr_accessor :current_zone
  attr_accessor :used_turn_effects
  
  def init_card_zones
    @monster_zones ||= Array.new(5)
    @spell_zones   ||= Array.new(5)
    @field_zone    ||= nil
  end
  
  def card_in_zone(zone, index)
    case zone
    when :monster
      @monster_zones[index]
    when :spell
      @st_zones[index]
    when :fieldspell
      @field_zone
    else
      nil
    end
  end
  
  def free_monster_zone_available?
    init_card_zones
    @monster_zones.any? { |z| z.nil? }
  end
  
  def st_zone_available?
    init_card_zones
    @st_zones.include?(nil)
  end
  
  def can_activate_impact?(impact_name)
    return false unless impact_name
    effect_data = PC27::CG::CARD_EFFECT[impact_name]
    return true unless effect_data
    target_zone = effect_data[1] 
    if target_zone == :deck
      return @deck.size > 0
    elsif target_zone == :grave
      return @grave.size > 0
    end
    true
  end
  
  def can_activate_summon_effect?(card)
    return false unless card
    return false if card.summon_impact.nil? || card.summon_impact == false || card.summon_impact == ""
    self.used_turn_effects ||= []
    if card.note =~ /<hopt:\s*(.+?)>/i
      hopt_list = $1.to_s.split(",").map { |s| s.strip }
      if hopt_list.include?(card.summon_impact)
        return false if self.used_turn_effects.include?(card.summon_impact)
      end
    end
    if card.note =~ /<shared_opt:\s*(.+?)>/i
      shared_name = $1.to_s.strip
      return false if self.used_turn_effects.include?(shared_name)
    end
    return meets_activation_requirements?(card, card.summon_impact)
  end
  
  def can_activate_field_effect?(card)
    return false unless card
    return false if card.field_impact.nil? || card.field_impact == false || card.field_impact == ""
    self.used_turn_effects ||= []
    eff_str = card.field_impact.to_s
    if card.note =~ /<hopt:\s*(.+?)>/i
      hopt_list = $1.to_s.split(",").map { |s| s.strip }
      if hopt_list.include?(eff_str)
        return false if self.used_turn_effects.include?(eff_str)
      end
    end
    if card.note =~ /<shared_opt:\s*(.+?)>/i
      shared_name = $1.to_s.strip
      return false if self.used_turn_effects.include?(shared_name)
    end
    return meets_activation_requirements?(card, eff_str)
  end
  
  def meets_activation_requirements?(card, effect_name)
    return false unless card && effect_name
    eff_str = effect_name.to_s 
    if card.note =~ /<req_ss_grave:\s*#{eff_str}\s*,\s*(\d+)(?:\s*,\s*(\d+))?>/i
      req_subtype = $1.to_i
      req_amount  = $2 ? $2.to_i : 1
      return false unless self.count_legal_ss_targets(req_subtype) >= req_amount
    end
    if card.note =~ /<req_deck_subtype:\s*#{eff_str}\s*,\s*(\d+)(?:\s*,\s*(\d+))?>/i
      req_subtype = $1.to_i
      req_amount = $2 ? $2.to_i : 1
      valid_count = self.deck.count { |c| c && c.subtype == req_subtype }
      return false unless valid_count >= req_amount
    end
    if card.note =~ /<req_grave_subtype:\s*#{eff_str}\s*,\s*(\d+)(?:\s*,\s*(\d+))?>/i
      req_subtype = $1.to_i
      req_amount = $2 ? $2.to_i : 1
      valid_count = self.grave.count { |c| c && c.subtype == req_subtype }
      return false unless valid_count >= req_amount
    end
    if card.note =~ /<req_field_other_subtype:\s*#{eff_str}\s*,\s*(\d+)(?:\s*,\s*(\d+))?>/i
      req_subtype = $1.to_i
      req_amount = $2 ? $2.to_i : 1
      valid_count = 0
      if self.monster_zones
        self.monster_zones.each do |c|
          valid_count += 1 if c && c.subtype == req_subtype
        end
      end
      if card.subtype == req_subtype
        has_target = (valid_count >= (req_amount + 1))
      else
        has_target = (valid_count >= req_amount)
      end
      return false unless has_target
    end
    return true
  end
  
  def used_turn_effects
    @used_turn_effects ||= []
  end
  
  #--------------------------------------------------------------------------
  # Verifica si hay blancos legales para Special Summon en una zona
  #--------------------------------------------------------------------------
  def has_legal_spec_summon_target?(zone_type, subtype)
    cards_to_check = case zone_type
                      when :grave then self.grave
                      when :hand  then self.hand
                      when :banish  then self.banish
                      when :deck  then self.deck
                      when :extra  then self.extra
                     else []
                     end
    cards_to_check.any? do |card|
      next false unless card && card.subtype == subtype
      is_nomi = (card.note =~ /<special_only:/i)
      if is_nomi
        card.properly_summoned == true
      else
        true
      end
    end
  end
  
  def count_legal_ss_targets(subtype)
    self.grave.count do |card|
      next false unless card && card.subtype == subtype
      if card.note =~ /<special_only:/i
        card.properly_summoned == true
      else
        true
      end
    end
  end
  
  #-----------------------------------------------------------------------------
  # Adds Hand, Deck, Grave, Banish, Extra, Field and Stack to an Actor (alias)
  #-----------------------------------------------------------------------------
  alias pc27_cardgame_gameactor_setup                                      setup
    def setup(actor_id)
      pc27_cardgame_gameactor_setup(actor_id)
